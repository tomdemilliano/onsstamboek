# Firebase client-SDK-configuratie -- van het NIEUWE, aparte Firebase-project
# van dit platform (Firebase Console -> Project Settings -> Algemeen -> "Je
# apps" -> Web-app -> SDK-configuratie). Publiek zichtbaar in de browser,
# dat is normaal voor Firebase-client-config (de echte beveiliging zit in
# firestore.rules / storage.rules).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK -- server-only, NOOIT NEXT_PUBLIC_-geprefixt. Van een
# service-account-sleutel (Project Settings -> Service accounts -> Generate
# new private key). Nodig voor het migratiescript en het (eenmalig) zetten
# van de systeembeheerder-custom-claim. Zie lib/adminCredential.ts.
#
# Optie A (aanbevolen): de VOLLEDIGE, ongewijzigde inhoud van het
# gedownloade service-account-JSON-bestand -- kan niet fout gaan bij het
# plakken (bv. in een GitHub-secret), in tegenstelling tot optie B.
FIREBASE_SERVICE_ACCOUNT_KEY=
#
# Optie B: dezelfde gegevens als 3 losse velden (enkel gebruiken als je
# geen zin hebt om de hele JSON-blob in één omgevingsvariabele te zetten,
# bv. sommige Vercel-schermen). Let op: FIREBASE_PRIVATE_KEY is multi-line
# en gaat makkelijk fout bij handmatig knippen/plakken.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Anthropic API -- OCR-herkenning van ingescande vriendenboekje-formulieren
# (app/api/extract-scan/route.ts, overgezet vanuit pages/api/extract.js in
# de oude app). Enkel nodig als groepsbeheerders de scan-upload gebruiken.
ANTHROPIC_API_KEY=

# Resend -- verstuurt de uitnodigingsmail wanneer de systeembeheerder een
# nieuwe gebruiker aanmaakt (app/api/systeembeheer/gebruikers/route.ts,
# lib/resend.ts). Vereist een Resend-account met een geverifieerd
# verzenddomein (bv. onsstamboek.be, via DNS-records bij je webhost).
RESEND_API_KEY=
# Optioneel, standaard "Ons Stamboek <noreply@onsstamboek.be>". Het adres
# moet op het bij Resend geverifieerde domein draaien.
RESEND_FROM_EMAIL=

# Enkel nodig om scripts/migrate.ts te draaien (eenmalig, de overzet van de
# bestaande Sint-Eduardus-data). BRON_ = het oude "Winkelsimpel"-project
# (enkel leestoegang nodig), DOEL_ = dit nieuwe project -- zelfde opties
# (volledige JSON of 3 losse velden) als hierboven, maar dan 2x met een
# prefix. Zie de uitgebreide uitleg bovenaan scripts/migrate.ts.
BRON_SERVICE_ACCOUNT_KEY=
# Enkel de bucket-NAAM, bv. winkelsimpel.appspot.com of
# winkelsimpel.firebasestorage.app (te vinden in de Firebase Console onder
# Storage, bovenaan). GEEN "gs://"-voorvoegsel en GEEN pad erachter (dus
# niet ".../vriendenboekje") -- het script voegt dat pad zelf toe.
BRON_STORAGE_BUCKET=
DOEL_SERVICE_ACCOUNT_KEY=
DOEL_STORAGE_BUCKET=
GROEP_ID=
ORGANISATIE_ID=
# Optioneel: migreer eerst een kleine testbatch foto's (bv. 10) voor je de
# volledige set (500+) draait -- kost bandbreedte, dus bewust in stappen.
FOTO_LIMIT=
# Optioneel: "true" om Storage (scans/foto's/kentekens/mijlpalen) helemaal
# over te slaan en enkel Firestore-data te migreren (zo goed als gratis).
SKIP_STORAGE=
